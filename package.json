{
  "name": "vitalogs",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:full": "npm run build && wrangler pages dev dist --d1 DB --port 8788",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "icons": "node scripts/gen-icons.mjs",
    "db:migrate:local": "wrangler d1 migrations apply vitalogs --local",
    "db:migrate:remote": "wrangler d1 migrations apply vitalogs --remote",
    "create-admin": "node scripts/create-admin.mjs"
  },
  "dependencies": {
    "@fontsource/plus-jakarta-sans": "^5.1.0",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "exceljs": "^4.4.0",
    "hono": "^4.13.12",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261003.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "sharp": "^0.35.5",
    "typescript": "^5.9.0",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
